# Copy this file to .env / .env.local and fill in real values. NEVER commit real secrets.
# Values marked "server only" must never be exposed to web/mobile clients.

# --- Supabase (database, auth, storage) ---
SUPABASE_URL=
# server only (new sb_secret_ format; equivalent to legacy service_role JWT)
SUPABASE_SECRET_KEY=
# server only
SUPABASE_SERVICE_ROLE_KEY=
# exposed to web/mobile clients (safe with RLS enabled)
SUPABASE_ANON_KEY=
# server only
SUPABASE_DB_PASSWORD=
# server only — direct connection (password percent-encoded, e.g. ! -> %21)
DATABASE_URL=
# server only — session pooler (port 5432) for migrations/tools
SUPABASE_SESSION_POOLER_URL=
# server only — transaction pooler (port 6543) for serverless runtimes
SUPABASE_POOLER_URL=

# --- Google AI Studio / Gemini (server only) ---
GEMINI_API_KEY=

# --- Cloudflare (server/CI only) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Web app (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Mobile app (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
