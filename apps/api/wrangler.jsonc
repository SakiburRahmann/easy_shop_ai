{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyshop-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Quota-first model rotation chain; secrets (GEMINI_API_KEY,
    // SUPABASE_URL, SUPABASE_SECRET_KEY) are set with `wrangler secret put`.
    "GEMINI_MODELS": "gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it",
  },
}
